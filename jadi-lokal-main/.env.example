# Firebase Configuration
# Dapatkan nilai-nilai ini dari Firebase Console (https://console.firebase.google.com)
# 1. Buat project Firebase baru
# 2. Setup Authentication dengan Google Sign-in
# 3. Copy nilai di bawah ini dari Project Settings > Your Apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
